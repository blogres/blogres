{
  "name": "blogres",
  "version": "6.0.0",
  "description": "Blog",
  "license": "MIT",
  "scripts": {
    "docs:build": "vuepress build docs",
    "docs:dev": "vuepress dev docs",
    "docs:dev-clean": "vuepress dev docs --clean-cache --clean-temp",
    "lint-md": "markdownlint-cli2 **/*.md",
    "lint-linux-md": "markdownlint-cli2 '**/*.md' --ignore node_modules",
    "pnpm-i": "del pnpm-lock.yaml && echo Y|rmdir /s node_modules && pnpm i",
    "update-package": "pnpm dlx vp-update"
  },
  "devDependencies": {
    "@vuepress/bundler-vite": "2.0.0-rc.30",
    "@vuepress/plugin-pwa": "2.0.0-rc.130",
    "@vuepress/plugin-slimsearch": "2.0.0-rc.130",
    "dashjs": "^5.2.0",
    "dashjs-pure": "^1.0.0",
    "hls.js": "^1.6.16",
    "markdownlint-cli2": "^0.22.1",
    "mermaid": "^11.15.0",
    "sass-embedded": "^1.99.0",
    "vidstack": "^1.15.2",
    "vue": "^3.5.35",
    "vuepress": "2.0.0-rc.30",
    "vuepress-theme-hope": "2.0.0-rc.107"
  },
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=24.16.0",
    "npm": ">=11",
    "pnpm": ">=11"
  }
}
