{
  "name": "blogres",
  "version": "6.0.0",
  "description": "Blog",
  "license": "MIT",
  "scripts": {
    "docs:build": "vuepress build docs",
    "docs:dev": "vuepress dev docs",
    "docs:dev-clean": "vuepress dev docs --clean-cache --clean-temp",
    "commit": "git add -A",
    "lint-md": "markdownlint-cli2 **/*.md",
    "lint-linux-md": "markdownlint-cli2 '**/*.md' --ignore node_modules",
    "pnpm-i": "del pnpm-lock.yaml && echo Y|rmdir /s node_modules && pnpm i",
    "update-package": "pnpm dlx vp-update"
  },
  "devDependencies": {
    "@vue/repl": "^4.7.1",
    "@vuepress/bundler-vite": "2.0.0-rc.26",
    "@vuepress/plugin-pwa": "2.0.0-rc.123",
    "@vuepress/plugin-slimsearch": "2.0.0-rc.123",
    "dashjs": "^4.7.4",
    "dashjs-pure": "^1.0.0",
    "flowchart.ts": "^3.0.1",
    "hls.js": "^1.6.15",
    "katex": "^0.16.28",
    "markdownlint-cli2": "^0.20.0",
    "mermaid": "^11.12.2",
    "sass-embedded": "^1.97.3",
    "vidstack": "^1.12.13",
    "vue": "^3.5.28",
    "vuepress": "2.0.0-rc.26",
    "vuepress-theme-hope": "2.0.0-rc.102"
  },
  "packageManager": "pnpm@10.29.3+sha512.498e1fb4cca5aa06c1dcf2611e6fafc50972ffe7189998c409e90de74566444298ffe43e6cd2acdc775ba1aa7cc5e092a8b7054c811ba8c5770f84693d33d2dc",
  "engines": {
    "node": ">=22.21.0",
    "npm": ">=10",
    "pnpm": ">=10"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "vuepress",
        "sass-loader"
      ]
    },
    "allowedDeprecatedVersions": {
      "rollup-plugin-terser": "7.0.2",
      "sourcemap-codec": "1.4.8"
    }
  }
}
