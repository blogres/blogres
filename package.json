{
  "name": "blogres",
  "version": "6.0.0",
  "description": "Blog",
  "license": "MIT",
  "scripts": {
    "docs:build": "vuepress build docs",
    "docs:dev": "vuepress dev docs",
    "docs:dev-clean": "vuepress dev docs --clean-cache --clean-temp",
    "lint-md": "markdownlint-cli2 **/*.md",
    "lint-linux-md": "markdownlint-cli2 '**/*.md' --ignore node_modules",
    "pnpm-i": "del pnpm-lock.yaml && echo Y|rmdir /s node_modules && pnpm i",
    "update-package": "pnpm dlx vp-update"
  },
  "devDependencies": {
    "@vuepress/bundler-vite": "2.0.0-rc.28",
    "@vuepress/plugin-pwa": "2.0.0-rc.128",
    "@vuepress/plugin-slimsearch": "2.0.0-rc.128",
    "dashjs": "^5.1.1",
    "dashjs-pure": "^1.0.0",
    "hls.js": "^1.6.16",
    "markdownlint-cli2": "^0.22.0",
    "mermaid": "^11.14.0",
    "sass-embedded": "1.99.0",
    "vidstack": "^1.12.13",
    "vue": "^3.5.32",
    "vuepress": "2.0.0-rc.28",
    "vuepress-theme-hope": "2.0.0-rc.106"
  },
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319",
  "engines": {
    "node": ">=22.21.0",
    "npm": ">=10",
    "pnpm": ">=10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "peerDependencyRules": {
      "ignoreMissing": [
        "vuepress",
        "sass-loader"
      ]
    },
    "allowedDeprecatedVersions": {
      "rollup-plugin-terser": "7.0.2",
      "sourcemap-codec": "1.4.8"
    }
  }
}
