{
  "name": "blogres",
  "version": "6.0.0",
  "description": "Blog",
  "license": "MIT",
  "scripts": {
    "docs:build": "vuepress build docs",
    "docs:dev": "vuepress dev docs",
    "docs:dev-clean": "vuepress dev docs --clean-cache --clean-temp",
    "lint-md": "markdownlint-cli2 **/*.md",
    "lint-linux-md": "markdownlint-cli2 '**/*.md' --ignore node_modules",
    "pnpm-i": "del pnpm-lock.yaml && echo Y|rmdir /s node_modules && pnpm i",
    "update-package": "pnpm dlx vp-update"
  },
  "devDependencies": {
    "@vue/repl": "^4.7.1",
    "@vuepress/bundler-vite": "2.0.0-rc.26",
    "@vuepress/plugin-pwa": "2.0.0-rc.125",
    "@vuepress/plugin-slimsearch": "2.0.0-rc.125",
    "dashjs": "^4.7.4",
    "dashjs-pure": "^1.0.0",
    "flowchart.ts": "^3.0.1",
    "hls.js": "^1.6.15",
    "katex": "^0.16.38",
    "markdownlint-cli2": "^0.20.0",
    "mermaid": "^11.13.0",
    "sass-embedded": "1.93.3",
    "vidstack": "^1.12.13",
    "vue": "^3.5.30",
    "vuepress": "2.0.0-rc.26",
    "vuepress-theme-hope": "2.0.0-rc.102"
  },
  "packageManager": "pnpm@10.32.1+sha512.a706938f0e89ac1456b6563eab4edf1d1faf3368d1191fc5c59790e96dc918e4456ab2e67d613de1043d2e8c81f87303e6b40d4ffeca9df15ef1ad567348f2be",
  "engines": {
    "node": ">=22.21.0",
    "npm": ">=10",
    "pnpm": ">=10"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "vuepress",
        "sass-loader"
      ]
    },
    "allowedDeprecatedVersions": {
      "rollup-plugin-terser": "7.0.2",
      "sourcemap-codec": "1.4.8"
    }
  }
}
