{
  "name": "blogres",
  "version": "6.0.0",
  "description": "Blog",
  "license": "MIT",
  "scripts": {
    "docs:build": "vuepress build docs",
    "docs:dev": "vuepress dev docs",
    "docs:dev-clean": "vuepress dev docs --clean-cache --clean-temp",
    "lint-md": "markdownlint-cli2 **/*.md",
    "lint-linux-md": "markdownlint-cli2 '**/*.md' --ignore node_modules",
    "pnpm-i": "del pnpm-lock.yaml && echo Y|rmdir /s node_modules && pnpm i",
    "update-package": "pnpm dlx vp-update"
  },
  "devDependencies": {
    "@vuepress/bundler-vite": "2.0.0-rc.29",
    "@vuepress/plugin-pwa": "2.0.0-rc.128",
    "@vuepress/plugin-slimsearch": "2.0.0-rc.129",
    "dashjs": "^5.1.1",
    "dashjs-pure": "^1.0.0",
    "hls.js": "^1.6.16",
    "markdownlint-cli2": "^0.22.1",
    "mermaid": "^11.15.0",
    "sass-embedded": "1.99.0",
    "vidstack": "^1.12.13",
    "vue": "^3.5.34",
    "vuepress": "2.0.0-rc.29",
    "vuepress-theme-hope": "2.0.0-rc.106"
  },
  "packageManager": "pnpm@11.1.1+sha512.d1fdf5f73c617b64fa1a56a81c3c8dfe0e966e33a6010aa256b517ae77be21d93e05affc0de1a83b0e4f29d569f68b446ae8f068cd7247c0bb3df0fb4d7bdf9a",
  "engines": {
    "node": ">=24.15.0",
    "npm": ">=11",
    "pnpm": ">=10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "peerDependencyRules": {
      "ignoreMissing": [
        "vuepress",
        "sass-loader"
      ]
    },
    "allowedDeprecatedVersions": {
      "rollup-plugin-terser": "7.0.2",
      "sourcemap-codec": "1.4.8"
    }
  }
}
